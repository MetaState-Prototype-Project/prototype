# Standalone eVault configuration. Copy to docker/evault/.env and fill in.
# Every value marked CHANGE ME must be set before starting.

# --- Databases (internal to the compose network) ---------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_neo4j_password

# --- Your public URLs (HTTPS, behind your reverse proxy) --------------------
# The eVault URL is written into the Registry for every eName you provision,
# so apps and wallets everywhere use it to reach the vault. It must be
# publicly reachable with a publicly trusted certificate.
PUBLIC_EVAULT_SERVER_URI=https://evault.example.org
# Base URL of this provisioner (port 3001 behind the proxy). Signed binding
# documents point at <this URL>/.well-known/jwks.json.
PUBLIC_PROVISIONER_URL=https://provisioner.example.org

# --- The Registry this eVault joins ----------------------------------------
# Production W3DS Registry. Use https://registry.staging.metastate.foundation
# for staging.
PUBLIC_REGISTRY_URL=https://registry.w3ds.metastate.foundation
# Lets the provisioner register new eNames in the Registry. Issued by the
# Registry operator; ask the W3DS team for it. Never commit it.
REGISTRY_SHARED_SECRET=CHANGE_ME_issued_by_registry_operator

# --- Provisioner identity ---------------------------------------------------
# 32-byte hex seed for the Ed25519 key that signs binding documents.
# Generate with: openssl rand -hex 32
PROVISIONER_SIGNING_SEED=CHANGE_ME_64_hex_chars
PROVISIONER_KID=provisioner-1
# Name this provisioner uses when it asks the Registry for a platform token.
PLATFORM_NAME=provisioner

# --- Provisioning without ID verification -----------------------------------
# A /provision request whose verificationId equals this value skips ID
# verification. The default (d66b7138-538a-465f-a6ce-f6985854c3f4) is public
# and is what the dev sandbox sends, which is fine for a closed test. Set your
# own random UUID (uuidgen) before anyone else can reach the provisioner.
# DEMO_CODE_W3DS=

# --- Reverse proxy ----------------------------------------------------------
# Address(es) of the proxy in front of eVault Core, so rate limiting sees the
# real client IP. On the default Docker bridge network the proxy reaches the
# container from the bridge range.
EVAULT_TRUST_PROXY=172.16.0.0/12

# --- Optional ----------------------------------------------------------------
# Rate limits (requests per minute)
# RATE_LIMIT_PER_PLATFORM=250
# RATE_LIMIT_PER_IP=500
# Enables the rate-limit admin API used by the control panel. Long random value.
# RATE_LIMIT_ADMIN_SECRET=
# Awareness service the eVault pushes change events to. Without it /ready
# reports "not-ready", but reads and writes still work.
# AWARENESS_SERVICE_URL=
# AWARENESS_INGEST_SECRET=
# Only needed if you run your own ID verification (Didit) on this provisioner.
# DIDIT_API_KEY=
# DIDIT_WORKFLOW_ID=
# PROVISIONER_SHARED_SECRET=
# Postgres over TLS: PEM of the CA that signed the database certificate.
# DB_CA_CERT=
