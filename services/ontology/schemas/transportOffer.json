{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaId": "9282c53c-5d80-4f7a-b243-ce5c68db1888",
  "title": "TransportOffer",
  "domain": "mobility",
  "type": "object",
  "description": "FMaaS/W3DS commercial offer, informed by DCSA Booking/charges terminology; not a DCSA standardized TransportOffer. Uses W3DS envelope URIs to link independently stored records.",
  "properties": {
    "id": {
      "type": "string",
      "description": "Application-level offer ID"
    },
    "issuerEName": {
      "type": "string",
      "description": "Party issuing offer",
      "pattern": "^@[^\\s]+$"
    },
    "carrierEName": {
      "type": "string",
      "description": "Carrier responsible for offered service",
      "pattern": "^@[^\\s]+$"
    },
    "label": {
      "type": "string"
    },
    "parent": {
      "type": "string",
      "pattern": "^w3ds://envelope\\?id=@[^\\s/]+/[^\\s]+$",
      "description": "W3DS ShipmentRequest envelope this offer responds to"
    },
    "price": {
      "$ref": "#/definitions/monetaryAmount",
      "description": "Optional offered total if known"
    },
    "lineItems": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/transportCharge"
      },
      "description": "Offered prices and rate basis",
      "minItems": 1
    },
    "serviceScope": {
      "type": "string",
      "enum": [
        "door_to_door",
        "door_to_port",
        "port_to_door",
        "port_to_port",
        "other"
      ]
    },
    "deliveryWindow": {
      "$ref": "#/definitions/deliveryWindow"
    },
    "validThrough": {
      "type": "string",
      "description": "Offer acceptance deadline",
      "format": "date-time"
    },
    "terms": {
      "type": "string",
      "description": "Summary or externally managed terms reference"
    },
    "metadata": {
      "type": "object",
      "description": "Optional application-specific extensions; must not redefine standardized fields.",
      "additionalProperties": true
    },
    "createdAt": {
      "type": "string",
      "description": "Creation timestamp",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "description": "Update timestamp",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "issuerEName",
    "carrierEName",
    "lineItems",
    "createdAt"
  ],
  "additionalProperties": false,
  "definitions": {
    "monetaryAmount": {
      "type": "object",
      "description": "Non-negative monetary amount in ISO 4217 currency; shared FMaaS structure.",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "description": "ISO 4217 currency",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "value",
        "currency"
      ],
      "additionalProperties": false
    },
    "transportCharge": {
      "type": "object",
      "description": "Proposed or agreed transport charge and calculation basis. Rate basis is FMaaS-specific, not a DCSA enum.",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "rate": {
          "$ref": "#/definitions/monetaryAmount"
        },
        "rateBasis": {
          "type": "string",
          "enum": [
            "per_shipment",
            "per_container",
            "per_hour",
            "per_kilometer",
            "per_mile",
            "per_milestone",
            "per_unit"
          ]
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "metadata": {
          "type": "object",
          "description": "Optional application-specific extensions; must not redefine standardized fields.",
          "additionalProperties": true
        }
      },
      "required": [
        "description",
        "rate",
        "rateBasis"
      ],
      "additionalProperties": false
    },
    "deliveryWindow": {
      "type": "object",
      "description": "Shipper-requested or contractually agreed transit-day constraints from pickup, not a predicted ETA.",
      "properties": {
        "preferredDeliveryDays": {
          "type": "integer",
          "minimum": 1
        },
        "latestDeliveryDays": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "preferredDeliveryDays"
          ]
        },
        {
          "required": [
            "latestDeliveryDays"
          ]
        }
      ]
    }
  }
}
