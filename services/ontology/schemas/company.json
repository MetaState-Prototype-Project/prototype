{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaId": "0f9a3cb8-4a9f-4b5f-a1fa-3a4c2eb1f402",
  "title": "Company",
  "domain": "work",
  "description": "A company's profile. The earliest Company record naming its own eVault is that eVault's manifest.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Application-level company identifier"
    },
    "eName": {
      "type": "string",
      "description": "eName of the company eVault"
    },
    "groupManifestEnvelopeId": {
      "type": "string",
      "description": "MetaEnvelope ID of the canonical GroupManifest"
    },
    "legalName": {
      "type": "string",
      "description": "Registered legal name"
    },
    "displayName": {
      "type": "string",
      "description": "Name shown to people"
    },
    "description": {
      "type": "string"
    },
    "logo": {
      "type": "string",
      "description": "Logo URL or w3ds://file URI"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "telephone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "registrationNumber": {
      "type": "string",
      "description": "Company registration number in its jurisdiction"
    },
    "jurisdiction": {
      "type": "string",
      "description": "Jurisdiction of registration, e.g. an ISO 3166 code"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "eName",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
