{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaId": "660d6086-f9bd-4f9a-a07c-a3f5c220abf7",
  "title": "FreightPackage",
  "domain": "mobility",
  "type": "object",
  "description": "Transportable physical package with stable identity and independently described contents. DCSA-informed, not DCSA-conformant package payload. Uses W3DS envelope URIs to link independently stored records.",
  "properties": {
    "id": {
      "type": "string",
      "description": "Application-level package ID"
    },
    "ownerEName": {
      "type": "string",
      "description": "W3DS identity of party owning or sending package",
      "pattern": "^@[^\\s]+$"
    },
    "label": {
      "type": "string",
      "description": "Human-readable package label"
    },
    "name": {
      "type": "string",
      "description": "Short name of package or goods",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "weight": {
      "type": "object",
      "description": "Gross package weight, including packaging; unit codes use UN/CEFACT notation.",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "KGM",
            "GRM",
            "TNE",
            "LBR",
            "ONZ"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "contents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/packageContents"
      },
      "description": "Optional list of goods and declared value per line; inline contents, not separate vault envelopes."
    },
    "metadata": {
      "type": "object",
      "description": "Optional application-specific extensions; must not redefine standardized fields.",
      "additionalProperties": true
    },
    "createdAt": {
      "type": "string",
      "description": "Record creation time",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "description": "Record update time",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "ownerEName",
    "name",
    "createdAt"
  ],
  "additionalProperties": false,
  "definitions": {
    "packageContents": {
      "type": "object",
      "description": "Contents line of a package, supporting per-SKU declared value. Inspired by DCSA cargo/commodity concepts, not identical to its objects.",
      "properties": {
        "sku": {
          "type": "string",
          "description": "Optional SKU/stock reference"
        },
        "description": {
          "type": "string",
          "description": "Description of the goods",
          "minLength": 1
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "declaredValue": {
          "$ref": "#/definitions/monetaryAmount",
          "description": "Declared value for this contents line"
        },
        "metadata": {
          "type": "object",
          "description": "Optional application-specific extensions; must not redefine standardized fields.",
          "additionalProperties": true
        }
      },
      "required": [
        "description",
        "quantity"
      ],
      "additionalProperties": false
    },
    "monetaryAmount": {
      "type": "object",
      "description": "Non-negative monetary amount in ISO 4217 currency; shared FMaaS structure.",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "description": "ISO 4217 currency",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "value",
        "currency"
      ],
      "additionalProperties": false
    }
  }
}
