{
    "name": "w3ds-oidc-connector",
    "version": "0.1.0",
    "private": true,
    "description": "OpenID Connect provider whose login step is a W3DS wallet signature",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "test": "vitest run",
        "check-types": "tsc --noEmit",
        "generate-jwk": "tsx scripts/generate-signing-jwk.ts",
        "migrate": "tsx src/scripts/migrate.ts"
    },
    "dependencies": {
        "@metastate-foundation/auth": "workspace:*",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.2",
        "jose": "^5.2.2",
        "pg": "^8.11.3",
        "qrcode": "^1.5.4",
        "typeorm": "^0.3.24"
    },
    "devDependencies": {
        "@testcontainers/postgresql": "^10.0.1",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.24",
        "@types/qrcode": "^1.5.6",
        "@types/supertest": "^6.0.2",
        "supertest": "^7.0.0",
        "tsx": "^4.19.2",
        "typescript": "~5.6.2",
        "vitest": "^3.2.4"
    }
}
